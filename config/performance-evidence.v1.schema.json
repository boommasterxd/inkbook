{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkbook.local/schemas/performance-evidence-v1.json",
  "title": "Inkbook PerformanceEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "version",
    "profileId",
    "profileVersion",
    "commit",
    "tag",
    "artifact",
    "fixtures",
    "cells",
    "manualReviewer"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "PerformanceEvidenceV1" },
    "version": { "const": 1 },
    "profileId": { "type": "string", "minLength": 1 },
    "profileVersion": { "const": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tag": { "type": "string", "pattern": "^v[0-9].*$" },
    "artifact": { "$ref": "#/$defs/artifact" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fixture" }
    },
    "cells": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/cell" }
    },
    "manualReviewer": { "$ref": "#/$defs/reviewer" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mainJsSha256",
        "mainJsBytes",
        "mainJsGzipBytes",
        "embeddedWorkerSha256",
        "embeddedWorkerBytes",
        "stylesCssSha256",
        "stylesCssBytes",
        "stylesCssGzipBytes",
        "packageChecksums"
      ],
      "properties": {
        "mainJsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mainJsBytes": { "type": "integer", "minimum": 1 },
        "mainJsGzipBytes": { "type": "integer", "minimum": 1 },
        "embeddedWorkerSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "embeddedWorkerBytes": { "type": "integer", "minimum": 1 },
        "stylesCssSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stylesCssBytes": { "type": "integer", "minimum": 1 },
        "stylesCssGzipBytes": { "type": "integer", "minimum": 1 },
        "packageChecksums": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generator", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "generator": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host",
        "os",
        "device",
        "refreshRateHz",
        "budgetClass",
        "results"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "refreshRateHz": {
          "anyOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "null" }
          ]
        },
        "budgetClass": { "enum": ["desktopTablet", "androidPhone"] },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/result" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowId",
        "warmups",
        "samples",
        "thresholds",
        "p50",
        "p95",
        "p99",
        "maximum",
        "variance",
        "pass"
      ],
      "properties": {
        "rowId": { "type": "string", "pattern": "^P0-[A-Z0-9-]+$" },
        "warmups": { "type": "integer", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 },
        "thresholds": { "type": "object", "minProperties": 1 },
        "p50": { "type": "number", "minimum": 0 },
        "p95": { "type": "number", "minimum": 0 },
        "p99": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 },
        "variance": { "type": "number", "minimum": 0 },
        "pass": { "const": true }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reviewedAt", "attestation"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "minLength": 1 },
        "attestation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
