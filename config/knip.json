{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts!",
    "src/workers/shared-worker-entry.ts!",
    "scripts/*.mjs",
    "test/**/*.test.ts"
  ],
  "project": ["src/**/*.ts!", "scripts/*.mjs", "test/**/*.ts"],
