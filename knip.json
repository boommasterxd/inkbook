{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "src/main.ts!",
    "src/obsidian/plugin-runtime-entry.ts!",
    "src/obsidian/text/portable-math-entry.ts!",
    "src/persistence/worker/runtime/document-worker-entry.ts!",
    "src/rendering/ui/editor-chrome-entry.ts!",
    "scripts/*.mjs",
    "scripts/cache-lifecycle/run.cjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "test/**/*.{ts,tsx}",
    "scripts/*.mjs",
    "scripts/cache-lifecycle/*.{cjs,d.ts}",
    "test/unit/scripts/cache-lifecycle*.test.mjs",
    "test/unit/scripts/cache-lifecycle/*.cjs"
  ],
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": [
      "test/{unit,integration,performance}/**/*.test.{ts,tsx}",
      "test/unit/scripts/cache-lifecycle*.test.mjs"
    ]
  }
}
