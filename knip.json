{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["moment"],
  "ignoreExportsUsedInFile": true,
  "entry": [
    "src/main.ts!",
    "src/obsidian/plugin-runtime-entry.ts!",
    "src/obsidian/settings/import/import-example-images.ts!",
    "src/obsidian/text/portable-math-entry.ts!",
    "src/persistence/worker/runtime/document-worker-entry.ts!",
    "src/rendering/ui/editor-chrome-entry.ts!",
    "scripts/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "test/**/*.{ts,tsx}",
    "scripts/*.mjs",
    "scripts/cache-lifecycle/*.{cjs,d.ts}",
    "test/unit/scripts/*.mjs"
  ],
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": ["test/{unit,integration,performance}/**/*.test.{ts,tsx,mjs}"]
  }
}
