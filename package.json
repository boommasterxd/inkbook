{
  "name": "inkbook",
  "version": "0.1.0",
  "description": "Create and edit responsive handwriting embeds stored as portable SVG files.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "architecture": "depcruise --config .dependency-cruiser.mjs src",
    "benchmark": "npm run test:performance",
    "build": "node scripts/build.mjs",
    "ci": "npm run ci:quality && npm run benchmark",
    "ci:quality": "npm run format:check && npm run lint && npm run lint:styles && npm run lint:layout && npm run architecture && npm run typecheck && npm run typecheck:worker && npm run test:coverage && npm run duplication && npm run dead-code && npm run audit && npm run build && npm run package:verify",
    "dead-code": "node scripts/run-dead-code-checks.mjs",
    "dev": "node scripts/build.mjs --watch",
    "duplication": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:layout": "node scripts/verify-source-layout.mjs",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "package:verify": "node scripts/verify-package.mjs",
    "test": "vitest run test/unit test/integration",
    "test:coverage": "vitest run test/unit test/integration --coverage",
    "test:integration": "vitest run test/integration",
    "test:performance": "node scripts/run-performance-tests.mjs",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boommasterxd/inkbook.git"
  },
  "bugs": {
    "url": "https://github.com/boommasterxd/inkbook/issues"
  },
  "homepage": "https://github.com/boommasterxd/inkbook#readme",
  "devDependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-sonarjs": "4.2.0",
    "globals": "17.11.0",
    "happy-dom": "20.11.12",
    "jscpd": "5.0.16",
    "knip": "6.32.3",
    "obsidian": "1.13.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "terser": "5.51.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
