{
  "name": "inkbook",
  "version": "0.1.0",
  "description": "High-performance retained SVG annotations for native Obsidian Markdown views.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "duplicate:check": "jscpd --config config/jscpd.json",
    "dead-code:check": "knip --config config/knip.json",
    "architecture:check": "depcruise --config config/dependency-cruiser.cjs src test scripts",
    "dependency:check": "npm audit --audit-level=high",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run duplicate:check && npm run dead-code:check && npm run architecture:check && npm run dependency:check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boommasterxd/inkbook.git"
  },
  "bugs": {
    "url": "https://github.com/boommasterxd/inkbook/issues"
  },
  "author": "Yannick Schäfer",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=26.7.0 <27",
    "npm": ">=12.0.2 <13"
  },
  "packageManager": "npm@12.0.2",
  "devDependencies": {
    "@codemirror/commands": "6.10.1",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
