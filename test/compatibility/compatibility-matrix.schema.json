{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/boommasterxd/inkbook/test/compatibility/compatibility-matrix.schema.json",
  "title": "InkbookCompatibilityMatrixV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "minimumObsidianVersion",
    "releaseObsidianVersion",
    "cells"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "minimumObsidianVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "releaseObsidianVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/cell" }
    }
  },
  "definitions": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "platform",
        "deviceModel",
        "hardwareProfile",
        "osName",
        "osVersion",
        "osBuild",
        "obsidianVersion",
        "importedApis",
        "expectedCapabilities",
        "guardedFallbacks",
        "blocker"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": { "enum": ["pending", "ready", "blocked"] },
        "platform": {
          "enum": ["desktop-linux", "desktop-windows", "android", "ios"]
        },
        "deviceModel": { "type": ["string", "null"] },
        "hardwareProfile": { "type": ["string", "null"] },
        "osName": { "type": ["string", "null"] },
        "osVersion": { "type": ["string", "null"] },
        "osBuild": { "type": ["string", "null"] },
        "obsidianVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "importedApis": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expectedCapabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "guardedFallbacks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocker": { "type": ["string", "null"] }
      }
    }
  }
}
